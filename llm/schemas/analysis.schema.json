{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "verdict": { "type": "string", "enum": ["attack", "benign", "unknown"] },
    "source_ip": { "type": "string" },
    "destination_ip": { "type": "string" },
    "attack_interface": { "type": "string" },
    "attack_method": { "type": "string" },
    "attack_path": { "type": "string" },
    "attack_time": { "type": "string" },
    "severity": { "type": "string", "enum": ["low", "medium", "high", "critical", "unknown"] },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "evidence": { "type": "array", "items": { "type": "string" }, "minItems": 1, "maxItems": 6 },
    "analysis_reasoning": { "type": "string" },
    "potential_impact": { "type": "array", "items": { "type": "string" }, "minItems": 1, "maxItems": 4 },
    "immediate_actions": { "type": "array", "items": { "type": "string" }, "minItems": 1, "maxItems": 4 },
    "hardening_actions": { "type": "array", "items": { "type": "string" }, "minItems": 1, "maxItems": 4 },
    "false_positive_notes": { "type": "string" },
    "knowledge_references": { "type": "array", "items": { "type": "string" }, "maxItems": 4 },
    "summary": { "type": "string" }
  },
  "required": [
    "verdict", "source_ip", "destination_ip", "attack_interface", "attack_method",
    "attack_path", "attack_time", "severity", "confidence", "evidence",
    "analysis_reasoning", "potential_impact", "immediate_actions", "hardening_actions",
    "false_positive_notes", "knowledge_references", "summary"
  ],
  "additionalProperties": false
}
